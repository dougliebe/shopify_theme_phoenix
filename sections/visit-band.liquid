{%- style -%}
  .nph-visit-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 5% {{ section.settings.padding_bottom }}px;
  }

  .nph-visit-{{ section.id }} .nph-visit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 110rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .nph-visit-{{ section.id }} .nph-visit-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 6rem;
    }
  }

  .nph-visit-{{ section.id }} .nph-visit-heading {
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: 700;
    margin: 0 0 1.6rem;
  }

  .nph-visit-{{ section.id }} .nph-visit-content {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
  }

  .nph-visit-{{ section.id }} .nph-visit-content a {
    display: inline-block;
    color: rgb(var(--color-button));
    font-weight: 600;
    font-size: 1.8rem;
    text-decoration: none;
    margin-bottom: 1.4rem;
  }
{%- endstyle -%}

<div class="nph-visit-{{ section.id }} color-{{ section.settings.color_scheme }}" id="visit">
  <div class="nph-visit-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'column' -%}
        <div {{ block.shopify_attributes }}>
          <h3 class="nph-visit-heading">{{ block.settings.heading }}</h3>
          <div class="nph-visit-content">{{ block.settings.content }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Visit band",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Visit Us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Address or details</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visit band",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
