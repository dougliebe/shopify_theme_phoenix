{%- style -%}
  .nph-hero-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .nph-hero-{{ section.id }} .nph-hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 6rem 5%;
  }

  .nph-hero-{{ section.id }} .nph-hero-eyebrow {
    font-size: 1.3rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    font-weight: 600;
  }

  .nph-hero-{{ section.id }} .nph-hero-heading {
    font-family: var(--font-heading-family);
    font-size: 4rem;
    line-height: 1.08;
    font-weight: 700;
    max-width: 56rem;
    margin: 0;
  }

  .nph-hero-{{ section.id }} .nph-hero-text {
    font-size: 1.7rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
    max-width: 48rem;
  }

  .nph-hero-{{ section.id }} .nph-hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 0.5rem;
  }

  .nph-hero-{{ section.id }} .nph-hero-media {
    position: relative;
    min-height: 32rem;
  }

  .nph-hero-{{ section.id }} .nph-hero-media img,
  .nph-hero-{{ section.id }} .nph-hero-media .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .nph-hero-{{ section.id }} {
      grid-template-columns: 1.1fr 1fr;
      min-height: {{ section.settings.min_height }}px;
    }

    .nph-hero-{{ section.id }} .nph-hero-content {
      padding: 6rem 8% 6rem 5%;
    }

    .nph-hero-{{ section.id }} .nph-hero-heading {
      font-size: {{ section.settings.heading_size }}px;
    }
  }
{%- endstyle -%}

<div class="nph-hero-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="nph-hero-content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nph-hero-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="nph-hero-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="nph-hero-text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="nph-hero-buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 }}" class="button">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="nph-hero-media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '375,550,750,1100,1500,1780,2000',
          sizes: '(min-width: 750px) 45vw, 100vw',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero (split)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Traditional Oriental Massage · Stillwater, OK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ancient techniques, honest healing."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 60
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Nine Phoenix Massage brings time-tested Oriental bodywork — acupressure, cupping, and deep tissue — to the heart of Stillwater. Same-day appointments welcome.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Call to Book — (580) 716-8851"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "View Services"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Minimum height (desktop)",
      "default": 560
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero (split)"
    }
  ]
}
{% endschema %}
