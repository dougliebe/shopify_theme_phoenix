{%- style -%}
  .nph-services-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 5% {{ section.settings.padding_bottom }}px;
  }

  .nph-services-{{ section.id }} .nph-services-header {
    text-align: center;
    max-width: 64rem;
    margin: 0 auto 6rem;
  }

  .nph-services-{{ section.id }} .nph-services-eyebrow {
    font-size: 1.3rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    font-weight: 600;
    margin-bottom: 1.2rem;
  }

  .nph-services-{{ section.id }} .nph-services-heading {
    font-family: var(--font-heading-family);
    font-size: 3.6rem;
    font-weight: 700;
    margin: 0;
  }

  .nph-services-{{ section.id }} .nph-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.1rem;
    background: rgba(var(--color-foreground), 0.12);
    max-width: 110rem;
    margin: 0 auto;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  @media screen and (min-width: 750px) {
    .nph-services-{{ section.id }} .nph-services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nph-services-{{ section.id }} .nph-service-card {
    padding: 3.4rem 2.8rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nph-services-{{ section.id }} .nph-service-name {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 600;
  }

  .nph-services-{{ section.id }} .nph-service-desc {
    font-size: 1.5rem;
    line-height: 1.55;
    color: rgba(var(--color-foreground), 0.72);
    flex: 1;
  }

  .nph-services-{{ section.id }} .nph-service-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0.8rem;
    padding-top: 1.4rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  .nph-services-{{ section.id }} .nph-service-duration {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.55);
  }

  .nph-services-{{ section.id }} .nph-service-price {
    font-family: var(--font-heading-family);
    font-size: 2.1rem;
    font-weight: 600;
    color: rgb(var(--color-button));
  }
{%- endstyle -%}

<div class="nph-services-{{ section.id }} color-{{ section.settings.color_scheme }}" id="services">
  <div class="nph-services-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nph-services-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="nph-services-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
  <div class="nph-services-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'service' -%}
        <div class="nph-service-card color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
          <div class="nph-service-name">{{ block.settings.name }}</div>
          <div class="nph-service-desc">{{ block.settings.description }}</div>
          <div class="nph-service-meta">
            <span class="nph-service-duration">{{ block.settings.duration }}</span>
            <span class="nph-service-price">{{ block.settings.price }}</span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Service list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Services"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bodywork rooted in tradition"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Service name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of the service."
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration",
          "default": "60 min"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$65"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service list",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
