        "prenatal": {
          "type": "column",
          "settings": {
            "title": "Prenatal Massage",
            "text": "<p>A safe, nurturing massage designed to relieve the aches and swelling that come with pregnancy. 60 minute sessions.</p>"
          }
        },
        "sports": {
          "type": "column",
          "settings": {
            "title": "Sports Massage",
            "text": "<p>Focused bodywork to help you recover, improve mobility, and prevent injury. Available in 60 or 90 minute sessions.</p>"
          }
        },
        "reflexology": {
          "type": "column",
          "settings": {
            "title": "Reflexology",
            "text": "<p>Pressure-point therapy on the feet and hands to promote relaxation throughout the whole body. Available in 30 or 60 minute sessions.</p>"
          }
        }
