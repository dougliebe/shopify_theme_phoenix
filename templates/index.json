        },
        "deep-tissue": {
          "type": "column",
          "settings": {
            "title": "Deep Tissue Massage",
            "text": "<p>Firm, targeted pressure to release chronic tension held in muscles and connective tissue. Available in 60 or 90 minute sessions.</p>"
